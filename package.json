{
  "name": "grupparbete-backend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "concurrently \"npm run server\"  \"npm run browser-sync\"  \"npm run tailwind\"",
    "db": "cd data && type nul > FreakyFashion.db && cd ..",
    "dbu": "cd data && touch FreakyFashion.db && cd ..",
    "server": "nodemon ./bin/www",
    "browser-sync": "browser-sync start --no-notify --proxy \"localhost:8080\" --files \"public, views, routes\"",
    "tailwind": "npx tailwindcss -i ./src/input.css -o ./public/stylesheets/styles.css --watch"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "ejs": "~2.6.1",
    "express": "~4.16.1",
    "express-ejs-layouts": "^2.5.1",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.19",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.4"
  }
}
