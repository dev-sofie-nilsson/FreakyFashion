
  <form class="w-full p-5 flex flex-col gap-4" method="POST" action="/admin/categories/new">
    
    <h2 class="text-2xl font-bold">Ny kategori</h2>

    <div class="mt-2">
      <label for="namn" class="font-semibold block mb-1">Namn</label>
      <input 
        id="namn" 
        name="input"
        type="text" 
        maxlength="25"
        placeholder="Ange namn" 
        class="border-2 rounded-md px-2 py-1 w-68"
      >
    </div>

    <% if (locals.error) { %>
      <p class="text-red-500 text-sm mt-1">
        <%= error %>
      </p>
    <% } %>

    <button class="button mt-4 py-2 font-semibold">
      Lägg till
    </button>

  </form>