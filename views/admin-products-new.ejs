<h2 class="mb-5 text-3xl font-bold">Ny produkt</h2>

<form
  action="/admin/products/new"
  method="post"
  enctype="multipart/form-data"
  class="space-y-10"
>
  <!-- Namn input -->
  <div class="form-div">
    <label for="name" class="font-bold">Namn</label>
    <input
      type="text"
      name="title"
      id="name"
      placeholder="Ange namn"
      class="input-base max-w-xs"
    />
  </div>

  <!-- Beskrivning input -->
  <div class="form-div">
    <label for="description" class="font-bold">Beskrivning</label>
    <textarea
      name="description"
      id="description"
      placeholder="Ange beskrivning"
      class="input-base max-w-lg"
    ></textarea>
  </div>

  <!-- Välj fil input -->
  <div class="form-div">
    <label for="image" class="font-bold">Bild</label>
    <input type="file" name="image" id="image" class="hidden" />
    <label for="image" tabindex="0" class="button">Välj fil</label>
  </div>

  <!-- Märke input -->
  <div class="form-div">
    <label for="brand" class="font-bold">Märke</label>
    <input
      type="text"
      name="brand"
      id="brand"
      class="input-base max-w-lg"
      placeholder="Ange märke"
    />
  </div>

  <!-- SKU input -->
  <div class="form-div">
    <label for="sku" class="font-bold">SKU</label>
    <input
      type="text"
      name="sku"
      id="sku"
      class="input-base max-w-28"
      placeholder="Ange SKU"
    />
  </div>

  <!-- Pris input -->
  <div class="form-div">
    <label for="price" class="font-bold">Pris</label>
    <input
      type="number"
      name="price"
      id="price"
      class="input-base no-arrows max-w-28"
    />
  </div>

  <!-- Kategori dropdown -->
  <div class="form-div">
    <label for="category" class="font-bold">Kategori</label>
    <select name="category" id="category" class="input-base max-w-lg">
      <option value="" disabled selected hidden>Välj kategori</option>
      <% categories.forEach(category => { %>
      <option value="<%= category.id %>"><%= category.name %></option>
      <% }) %>
    </select>
  </div>

  <button type="submit" class="button mt-5">Lägg till</button>
</form>
