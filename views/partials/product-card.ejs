<div>
  <a href="/products/<%= product.slug %>">
    <!-- Container with product img + icon -->
    <div
      class="relative flex aspect-square items-center justify-center border p-4 sm:p-2 rounded-md"
    >
      <img
        src="<%= product.image_path %>"
        alt="Svart T-shirt"
        class="size-full object-contain"
      />
      <img
        src="/images/heart.png"
        alt="Favorit"
        class="absolute right-0 bottom-0 m-4"
      />
    </div>
    <!-- Container with product info -->
    <div
      class="flex flex-wrap justify-between gap-2 py-2 text-xl font-bold italic sm:text-base"
    >
      <h3><%= product.title %></h3>
      <p><%= product.price %> SEK</p>
      <p class="basis-full font-normal"><%= product.brand %></p>
    </div>
  </a>
</div>
