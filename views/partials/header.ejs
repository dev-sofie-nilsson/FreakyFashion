<header class="p-4">
  <div class="flex flex-wrap items-center gap-3 sm:flex-nowrap">
    <a href="/" class="w-full sm:w-80">
      <img src="\images\freakyfashion-logo.png" alt="Freaky Fashion Logo" class="h-auto w-full rounded-md" />
    </a>
    <!-- Search container -->
    <div class="relative min-w-1/2 grow sm:grow-0">
      <form class="w-full sm:max-w-md" role="search" aria-label="Sök produkter" method="GET" action="/search">
        <input type="search" name="q" maxlength="25"
          class="h-10 w-full rounded-lg border-2 border-black p-2 pl-10 outline-none" placeholder="Sök produkt"
          aria-label="Sök produkt" autofocus />
      </form>

      <img src="/images/searchIcon.png" class="absolute top-1/2 left-2 size-6 -translate-y-1/2" />
    </div>
    <!-- Icons -->
    <div class="flex shrink-0 gap-5 sm:ml-auto">
      <a href="#" aria-label="Favoriter">
        <img src="/images/heart.png" alt="Favorit" class="w-8" />
      </a>
      <a href="#" aria-label="Varukorg">
        <img src="/images/shopping-basket.png" alt="Varukorg" class="w-8" />
      </a>
    </div>
  </div>

  <nav class="mt-3 flex flex-col items-start gap-3 text-xl font-semibold sm:flex-row" aria-label="Huvudmeny">
    <% if (categories && categories.length> 0) { %>
      <% categories.forEach(category=> { %>
        <a href="/categories/<%= category.slug %>" class="rounded hover:text-pink-400">
          <%= category.name %>
        </a>
      <% }) %>
    <% } %>
  </nav>
</header>