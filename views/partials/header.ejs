<header class="p-3">
  <div class="flex flex-wrap items-center gap-3 sm:flex-nowrap">
    <a href="/" class="w-full sm:w-80">
      <img
        src="\images\freakyfashion-logo.png"
        alt="Freaky Fashion Logo"
        class="h-auto w-full"
      />
    </a>
    <!-- Search container -->
    <div class="relative min-w-1/2 grow gap-2 sm:grow-0">
      <form
        class="w-full sm:max-w-md"
        role="search"
        aria-label="Sök produkter"
        method="GET"
        action="/search"
      >
        <input
          type="search"
          name="q"
          class="h-10 w-full rounded-lg border border-black p-2 pl-10 text-base"
          placeholder="Sök produkt"
          aria-label="Sök produkt"
          autofocus
        />
      </form>
      <img
        src="/images/searchIcon.png"
        class="absolute top-1/2 left-2 size-6 -translate-y-1/2"
      />
    </div>
    <!-- Icons -->
    <div class="flex gap-3 sm:ml-auto">
      <a
        href="#"
        class="rounded hover:bg-[rgb(253,171,222)] hover:text-white"
        aria-label="Favoriter"
      >
        <img src="/images/heart.png" alt="Favorit" />
      </a>
      <a
        href="#"
        class="rounded hover:bg-[rgb(253,171,222)] hover:text-white"
        aria-label="Varukorg"
      >
        <img src="/images/shopping-basket.png" alt="Varukorg" />
      </a>
    </div>
  </div>

  <nav
    class="mt-3 flex flex-col items-start gap-1 sm:flex-row"
    aria-label="Huvudmeny"
  >
    <% if (categories && categories.length > 0) { %> <%
    categories.forEach(category => { %>
    <a
      href="/categories/<%= category.slug %>"
      class="rounded p-2 hover:text-pink-400"
    >
      <%= category.name %>
    </a>
    <% }) %> <% } %>
  </nav>
</header>
