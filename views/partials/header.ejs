<header class="p-3">
  <div class="flex flex-wrap items-center gap-3 sm:flex-nowrap">
    <a href="/" class="w-full sm:w-50">
      <img src="\images\freakyfashion-logo.png" alt="Freaky Fashion Logo" class="w-full sm:h-auto sm:w-50" />
    </a>
    <!-- Search container -->
    <div class="grow min-w-1/2 gap-2 sm:grow-0">
      <form class="w-full sm:max-w-md" role="search" aria-label="Sök produkter" method="GET" action="/search">
        <input type="search" class="h-10 w-full rounded-lg border border-black px-4 text-base"
          placeholder="🔍Sök produkt" aria-label="Sök produkt" />
      </form>
    </div>
    <!-- Icons -->
    <div class="flex gap-3 sm:ml-auto">
      <a href="#" class="rounded hover:bg-[rgb(253,171,222)] hover:text-white" aria-label="Favoriter">
        <img src="/images/heart.png" alt="Favorit" />
      </a>
      <a href="#" class="rounded hover:bg-[rgb(253,171,222)] hover:text-white" aria-label="Varukorg">
        <img src="/images/shopping-basket.png" alt="Varukorg" />
      </a>
    </div>

  </div>

 <nav class="mt-3 flex flex-col gap-1 sm:flex-row" aria-label="Huvudmeny">

  <% if (categories && categories.length > 0) { %>
    <% categories.forEach(category => { %>
      <a href="/categories/<%= category.slug %>" class="rounded p-2 hover:text-pink-400">
        <%= category.name %>
      </a>
    <% }) %>
  <% } %>
</nav>
</header>