<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <title>Admin kategorier</title>
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>

<body>
<%- include("partials/admin.ejs") %>
  <div class="w-full p-5">
    <div class="flex justify-between mb-6 gap-10">
      <h2 class="text-2xl font-bold ">Kategorier</h2>

      <button class="bg-gray-600 text-white px-6 py-2 rounded hover:bg-pink-400">
        Ny kategori
      </button>
    </div>

    <!-- Table -->
     <div class="border rounded-ms overflow-hidden">
      <table class="w-full text-left">

        <thead class="bg-gray-200">
          <tr class="even:bg-gray-100">
            <th class="px-6 py-3 font-semibold border-b">Namn</th>
          </tr>
        </thead>

        <tbody>

          <tr class="even:bg-gray-100">
            <td class="px-6 py-4">Kläder</td>
          </tr>

          <tr class="even:bg-gray-100">
            <td class="px-6 py-4">Accessoarer</td>
          </tr>

          <tr class="even:bg-gray-100">
            <td class="px-6 py-4">Skor</td>
          </tr>

        </tbody>

      </table>
      </div>

      <!-- Table -->
      <div class="border rounded-md overflow-hidden">
        <table class="w-full text-left">
          <thead class="bg-gray-200">
            <tr class="even:bg-gray-100">
              <th class="px-6 py-3 font-semibold border-b">Namn</th>
            </tr>
          </thead>

          <tbody>
            <tr class="even:bg-gray-100">
              <td class="px-6 py-4">Kläder</td>
            </tr>

            <tr class="even:bg-gray-100">
              <td class="px-6 py-4">Accessoarer</td>
            </tr>

            <tr class="even:bg-gray-100">
              <td class="px-6 py-4">Skor</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </body>
</html>
