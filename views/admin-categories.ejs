<section class="w-full p-5">
  <div class="mb-6 flex justify-between gap-10">
    <h2 class="text-2xl font-bold">Kategorier</h2>

    <a href="/admin/categories/new">
      <button
        class="rounded bg-gray-600 px-6 py-2 text-white hover:bg-pink-400"
      >
        Ny kategori
      </button>
    </a>
  </div>

  <!-- Table -->
  <div class="border rounded-md overflow-hidden">
    <table class="w-full text-left">
      <thead class="bg-gray-200">
        <tr class="even:bg-gray-100 border-b">
          <th class="p-4 font-semibold">Namn</th>
        </tr>
      </thead>

      <tbody>
        <% categories.forEach(category => { %>
        <tr class="even:bg-gray-100">
          <td class="p-4"><%= category.name %></td>
        </tr>
        <% }) %>
      </tbody>

    </table>
  </div>
</section>
