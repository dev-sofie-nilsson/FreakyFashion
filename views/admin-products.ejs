<section class="w-full p-5">
  <div class="flex justify-between mb-6 gap-10">
    <h2 class="text-2xl font-bold">Produkter</h2>

    <a href="/admin/products/new">
      <button
        class="bg-gray-600 text-white px-6 py-2 rounded hover:bg-pink-400"
      >
        Ny produkt
      </button>
    </a>
  </div>
  
  <!-- Table -->
  <div class="rounded-md border overflow-hidden">
    <table class="min-w-full text-left">
      <thead class="bg-gray-200">
        <tr class="even:bg-gray-100 border-b">
          <th class="p-4 font-semibold">Namn</th>
          <th class="p-4 border-l font-semibold">SKU</th>
          <th class="p-4 border-l font-semibold">Pris</th>
        </tr>
      </thead>

      <tbody>
        <% products.forEach((product) => { %>
          <tr class="even:bg-gray-100">
            <td class="p-4"><%= product.title %></td>
            <td class="p-4 border-l"><%= product.sku %></td>
            <td class="p-4 border-l"><%= product.price %> SEK</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>