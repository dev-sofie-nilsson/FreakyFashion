  <div class="w-full p-5">
    <div class="flex justify-between mb-6 gap-10">
      <h2 class="text-2xl font-bold">Produkter</h2>

      <button
        class="bg-gray-600 text-white px-6 py-2 rounded hover:bg-pink-400"
      >
        Ny produkt
      </button>
    </div>

    <!-- Table -->
    <div class="rounded-ms overflow-hidden">
      <table class="min-w-full text-left">
        <thead class="bg-gray-200">
          <tr class="even:bg-gray-100 border">
            <th class="px-4 py-3 border">Namn</th>
            <th class="px-4 border">SKU</th>
            <th class="px-4 border">Pris</th>
          </tr>
        </thead>

        <tbody>
          <% products.forEach((product, index) => { %>
            <tr class="even:bg-gray-100 <%= index === products.length - 1 ? 'border-b' : '' %>">
              <td class="px-6 py-4 border-l"><%= product.title %></td>
              <td class="px-4 border-l"><%= product.sku %></td>
              <td class="px-4 border-l border-r"><%= product.price %> kr</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>