<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/styles.css" />
  </head>

  <body>
    <main>
      <%- include("partials/header.ejs") %>
      <div class="p-4 flex flex-col sm:flex-row gap-4">
        <!-- Container with product img + icon -->
        <div class="border lg:w-1/2 sm:max-w-sm lg:min-w-sm relative">
          <img
            src="/images/ChatGPT_Image_22_apr._2026_09_28_38.png"
            alt="Svart T-shirt"
            class="aspect-4/5 h-full object-contain"
          />
          <img
            src="/images/heart.png"
            alt="Favorit"
            class="absolute right-4 bottom-4"
          />
        </div>
        <!-- Container with product info -->
        <div class="gap-2 rounded-b-md px-4 py-2 italic lg:w-1/2">
          <h3 class="text-2xl mt-3">Svart T-shirt</h3>
          <p class="basis-full font-normal text-1xl mt-4">Levi's</p>

          <p class="mt-4 sm:auto">
            Lorem, ipsum dolor sit amet consectetur adipisicing elit. Quas
            expedita rerum, perferendis natus ad quo a doloremque incidunt
            eveniet ipsa assumenda delectus praesentium aliquid, inventore ullam
            dolores voluptatum voluptas cumque.
          </p>
          <p class="basis-full mt-4">199 SEK</p>

          <div class="mt-4 justify-center sm:justify-start">
            <button
              class="mt-4 bg-gray-200 text-black w-full sm:w-auto sm:px-8 py-2 rounded hover:bg-gray-100 transition border"
            >
              Lägg i varukorg
            </button>
          </div>
        </div>
      </div>
      <h2 class="mt-10 text-2xl text-center hidden sm:block">
        Liknande produkter
      </h2>
      <div class="gap-3 p-4 mt-4 sm:grid grid-cols-3 hidden">
        <%-include("partials/product-card.ejs")%>
        <%-include("partials/product-card.ejs")%>
        <%-include("partials/product-card.ejs")%>
      </div>
      <%- include("partials/footer.ejs") %>
    </main>
  </body>
</html>
