<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/styles.css" />
  </head>

  <body>
    <main>
      <%- include("partials/header.ejs") %>
      <div class="p-4 sm:flex sm:flex-row sm:gap-4">
        <!-- Container with product img + icon -->
        <div
          class="relative aspect-4/5 rounded-md border sm:w-1/2 lg:max-w-2xl"
        >
          <img
            src="/images/ChatGPT_Image_22_apr._2026_09_28_38.png"
            alt="Svart T-shirt"
            class="size-full object-contain"
          />
          <img
            src="/images/heart.png"
            alt="Favorit"
            class="absolute right-4 bottom-4"
          />
        </div>
        <!-- Container with product info -->
        <div class="space-y-4 p-4 font-semibold italic sm:w-1/2 lg:max-w-2/5">
          <h3 class="text-2xl font-normal">Svart T-shirt</h3>
          <p class="font-normal">Levi's</p>

          <p class="">
            Lorem, ipsum dolor sit amet consectetur adipisicing elit. Quas
            expedita rerum, perferendis natus ad quo a doloremque incidunt
            eveniet ipsa assumenda delectus praesentium aliquid, inventore ullam
            dolores voluptatum voluptas cumque.
          </p>
          <p class="">199 SEK</p>
          <button
            class="w-full rounded-md border p-4 font-bold not-italic sm:w-auto"
          >
            Lägg i varukorg
          </button>
        </div>
      </div>
      <h2 class="mt-10 hidden text-center text-2xl sm:block">
        Liknande produkter
      </h2>
      <div
        class="mt-4 hidden grid-cols-3 gap-3 p-4 sm:grid lg:mx-auto lg:max-w-[2300px]"
      >
        <!-- TODO: Temporary fix, make actual logic -->
        <%-include("partials/product-card.ejs", {product: products[0]})%>
        <%-include("partials/product-card.ejs", {product: products[1]})%>
        <%-include("partials/product-card.ejs", {product: products[2]})%>
      </div>
      <%- include("partials/footer.ejs") %>
    </main>
  </body>
</html>
